" value='&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;every 15 min · 1 of 3 free jobs&lt;br&gt;OIDC → /tasks/poll-gmail&lt;/font&gt;' style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;shadow=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#202124;fontFamily=Helvetica;spacingLeft=60;strokeColor=#1A73E8;dashed=1;dashPattern=6 4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="260" y="650" width="230" height="64" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;aspect=fixed;connectable=0;" vertex="1" parent="c22"><mxGeometry x="12" y="12.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;Firestore (default)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;users/{sub}: plan + wallet→account&lt;br&gt;tokens encrypted in the app&lt;br&gt;└ runs/{msg}:{source}&lt;/font&gt;' style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;shadow=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#202124;fontFamily=Helvetica;spacingLeft=60;strokeColor=#1A73E8;dashed=1;dashPattern=6 4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="646" width="270" height="72" as="geometry"/></mxCell><mxCell id="c25" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;aspect=fixed;connectable=0;" vertex="1" parent="c24"><mxGeometry x="12" y="16.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Budget $1 / ₱50&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;alerts at 50 · 90 · 100%&lt;br&gt;on actual spend&lt;/font&gt;' style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;shadow=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#202124;fontFamily=Helvetica;spacingLeft=60;strokeColor=#1A73E8;dashed=1;dashPattern=6 4;strokeWidth=1.5;" 