# Copy this file to .env and fill it in. Never commit .env.

# Everything here is optional for the web app, which asks for your YNAB token on the page.

# YNAB personal access token, for the command line (pipeline.py) only.
# Create one in YNAB: Account Settings -> Developer Settings -> New Token.
BEARER_TOKEN=

# Random string that signs the web app's session cookie. Optional on your own
# computer: without it, each run makes a new one. Needed when hosting the app.
# Generate one: python -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=

# Web app port (optional, default 5050; 5000 is used by macOS AirPlay).
# APP_PORT=5050

# Where the web app saves your wallets and transfer rules on this computer
# (optional, default ~/.config/ph-statement-import/settings.json).
# LOCAL_SETTINGS_PATH=

# Leave empty on your own computer. Set it only on a server for other people,
# to the address they open (e.g. https://statements.example.com): that turns on
# hosted mode, with YNAB OAuth login only and no saved token. Hosted mode then
# needs FLASK_SECRET_KEY, YNAB_CLIENT_ID and YNAB_CLIENT_SECRET (see README).
PUBLIC_URL=

# --- CLI only (pipeline.py); the web app asks for these on the page ---

# Password for each source's statement PDF, named <SOURCE>_PDF_PASSWORD
# (see password_env in statement_etl/sources.py).
GCASH_PDF_PASSWORD=
# GoTyme PDF password: your date of birth as MMDDYYYY
GOTYME_PDF_PASSWORD=

# YNAB plan (budget) and account ids; find them with: python -m statement_etl.ynab_api.accounts
YNAB_PLAN_ID=
YNAB_ACCOUNT_ID=

# --- Optional: categorize with Gemini (python -m statement_etl.categorize) ---
# Also needs BEARER_TOKEN and YNAB_PLAN_ID above. Sends each uncategorized
# transaction's date, account, payee, memo and amount to Google (see README).
# Hosted mode: put it in APP_CONFIG instead; it turns on the opt-in
# "Categorize new transactions with Gemini" checkboxes.
# Create a key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Optional: OAuth instead of BEARER_TOKEN ---
# Only used when BEARER_TOKEN is empty. Register an OAuth application in
# YNAB Developer Settings with redirect URI http://localhost:5050/oauth/callback
# (in hosted mode: PUBLIC_URL followed by /oauth/callback)
# YNAB_CLIENT_ID=
# YNAB_CLIENT_SECRET=

# --- Optional: Gmail auto-import (hosted mode only: PUBLIC_URL must be set) ---
# Leave GOOGLE_CLIENT_ID empty to keep /auto-import off. On Cloud Run, pass
# GOOGLE_CLIENT_ID as an env var and put GOOGLE_CLIENT_SECRET, ENCRYPTION_KEYS
# and ALLOWED_GOOGLE_EMAILS inside the app-config secret (see README).
# Generate a Fernet key with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ENCRYPTION_KEYS=
# ALLOWED_GOOGLE_EMAILS=juan@example.com,maria@example.com
